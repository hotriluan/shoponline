# Copy to .env (never commit .env). Values come from the secret store.

# PostgreSQL connection for the app: postgresql+psycopg://USER:PASSWORD@localhost:5432/shoponline_dev
SHOPONLINE_DATABASE_URL=
# Only used by pytest; database name must end with _test
SHOPONLINE_TEST_DATABASE_URL=
# Random string, at least 32 characters, used to sign web sessions
SHOPONLINE_SECRET_KEY=
# Folder outside the repo for uploaded and generated files
SHOPONLINE_DATA_DIR=
# Web bind address and port (LAN address on the production machine)
SHOPONLINE_WEB_HOST=127.0.0.1
SHOPONLINE_WEB_PORT=8750

# Backups (scripts/windows/backup-db.ps1). Password lives in the secret store.
SHOPONLINE_BACKUP_PASSWORD=
# Folders separated by ';' (company network share; Google Drive for desktop folder)
SHOPONLINE_BACKUP_DIRS=
SHOPONLINE_BACKUP_KEEP_DAYS=30
# Database used by restore-db.ps1 drills (never the production one)
SHOPONLINE_RESTORE_DATABASE_URL=
