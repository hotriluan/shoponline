# Copy to .env (never commit .env). Values come from the secret store.

# PostgreSQL connection for the app: postgresql+psycopg://USER:PASSWORD@localhost:5432/shoponline_dev
SHOPONLINE_DATABASE_URL=
# Only used by pytest; database name must end with _test
SHOPONLINE_TEST_DATABASE_URL=
# Random string, at least 32 characters, used to sign web sessions
SHOPONLINE_SECRET_KEY=
# Folder outside the repo for uploaded and generated files
SHOPONLINE_DATA_DIR=
# Web bind address and port (LAN address on the production machine)
SHOPONLINE_WEB_HOST=127.0.0.1
SHOPONLINE_WEB_PORT=8750

# Backups (uv run shoponline backup ...). Password lives in the secret store.
SHOPONLINE_BACKUP_PASSWORD=
# Folders on this machine or the network, separated by ';' (company share, another disk).
# Google Drive is connected on the web page "Sao lưu", not through a folder here.
# When and how many backups to keep are set on that page too, not here.
SHOPONLINE_BACKUP_DIRS=
# Scratch database for restore drills (never the production one)
SHOPONLINE_RESTORE_DATABASE_URL=

# SAP robot (docs/robot-machine-setup.md). These are only the initial values: the first run copies
# them into the database, after that edit them on the web page Robot SAP > Kết nối SAP.
# Leave SYSTEM/CLIENT empty to keep the robot out.
SHOPONLINE_SAP_SYSTEM=
SHOPONLINE_SAP_CLIENT=
SHOPONLINE_SAP_CONNECTION=
SHOPONLINE_SAP_USER=
SHOPONLINE_SAP_LANGUAGE=
SHOPONLINE_ROBOT_MAX_FAILURES=3
SHOPONLINE_ROBOT_EVIDENCE_KEEP_DAYS=30
# The SAP password is not set here: on the robot machine run `shoponline sap-password set`.

# Days to keep customer names/addresses and stored workbooks (shoponline retention).
SHOPONLINE_RETENTION_DAYS=90
